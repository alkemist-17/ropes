{
  "name": "ropes",
  "version": "1.0.0",
  "description": "A TypeScript library for generating cryptographically secure random strings with configurable alphabets, sizes, and formatting options.",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest --no-watch",
    "prepublishOnly": "npm run build",
    "start": "tsc && node ."
  },
  "keywords": [
    "random",
    "string",
    "generator",
    "crypto",
    "cryptography",
    "token",
    "id",
    "uuid",
    "password",
    "alphabet",
    "base64",
    "hex"
  ],
  "author": "Eduardo Velazco Romero",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/seedrandom": "^3.0.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
